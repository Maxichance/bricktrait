{
	"name": "bricktrait",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"parts": "node scripts/fetch-ldraw.mjs && node scripts/build-parts.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.4",
		"@types/three": "^0.186.0",
		"fflate": "^0.8.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"three": "^0.186.1"
	},
	"description": "Minifig profile picture maker built on the LDraw parts library",
	"author": "Maxichance",
	"homepage": "https://maxichance.github.io/bricktrait/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Maxichance/bricktrait.git"
	},
	"bugs": "https://github.com/Maxichance/bricktrait/issues",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	}
}
